{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daewangampark",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./dist/_worker.js/index.js",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "routes": [
    {
      "pattern": "daewangampark.com",
      "custom_domain": true
    }
  ]
}
