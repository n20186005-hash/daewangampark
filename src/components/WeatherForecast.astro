---
import { getLangFromUrl, getMessagesByLang, intlLocale } from '../i18n/ui';
import {
  getWeather,
  weatherCodeInfo,
  uvLevelKey,
  weekdayLabel,
  monthDayLabel,
  beaufort,
  buildBrief,
} from '../lib/weather';
import type { AdviceNote } from '../lib/weather';

interface Props {
  lang?: string;
}

const lang = Astro.props.lang || getLangFromUrl(Astro.url);
const messages = getMessagesByLang(lang);
const w = messages.weather ?? {};
const b = w.brief ?? {};
const locale = intlLocale(lang);

// Server-side fetch with a warm-cache short-circuit, so the module ships as
// HTML the moment the fragment is requested.
const data = await getWeather();
const now = data?.current ?? null;
const today = data?.days?.[0] ?? null;
const brief = data ? buildBrief(data) : null;

const condition = (code: number) => w.conditions?.[weatherCodeInfo(code).key] ?? w.conditions?.unknown ?? '—';
const compass = (key: string) => w.compass?.[key] ?? '';

/** Fill the `{placeholders}` of a localised template. */
const fill = (template: unknown, params?: Record<string, string | number>) =>
  String(template ?? '').replace(/\{(\w+)\}/g, (_, name: string) => String(params?.[name] ?? ''));

const noteText = (note: AdviceNote) => fill(b[note.group]?.[note.key], note.params);

const forceShort = (kmh: number) => fill(w.forceShort, { n: beaufort(kmh) });

const ITEM_ICONS: Record<string, string> = {
  umbrella: '☂️',
  raincoat: '🧥',
  sunscreen: '🧴',
  sunglasses: '🕶️',
  hat: '🧢',
  water: '💧',
  scarf: '🧣',
  coat: '🧥',
  jacket: '🧥',
  gripShoes: '👟',
  mask: '😷',
};

const riskLines = (brief?.risks ?? []).map(noteText).filter(Boolean);
const outfitLines = (brief?.outfit ?? []).map(noteText).filter(Boolean);
const planLines = (brief?.plan ?? []).map(noteText).filter(Boolean);
const itemLines = (brief?.items ?? [])
  .map((note) => ({ icon: ITEM_ICONS[note.key] ?? '•', text: noteText(note) }))
  .filter((line) => line.text);

const metrics = (() => {
  if (!now || !today) return [];
  const rows = [
    { icon: '🌡️', label: w.feelsLike, value: `${Math.round(now.apparent)}°` },
    { icon: '☂️', label: w.precipChance, value: `${Math.round(today.precipProbability)}%` },
    // The labels already read "Wind" / "Gusts", so the value stays a bare force
    // ("Force 5") rather than repeating the word.
    { icon: '💨', label: w.wind, value: `${forceShort(now.windSpeed)} ${compass(now.windCompass)}`.trim() },
  ];
  if (beaufort(now.windGust) > beaufort(now.windSpeed)) {
    rows.push({ icon: '🌬️', label: w.gust, value: forceShort(now.windGust) });
  }
  rows.push({ icon: '💧', label: w.humidity, value: `${Math.round(now.humidity)}%` });
  rows.push({
    icon: '🔆',
    label: w.uvIndex,
    value: `${Math.round(now.uvIndex)} · ${w.uvLevels?.[uvLevelKey(now.uvIndex)] ?? ''}`,
  });
  return rows;
})();
---

<section id="weather" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">
      {w.title}
    </h2>
    {w.subtitle && (
      <p class="text-center text-base sm:text-lg mb-10 max-w-3xl mx-auto" style="color: var(--text-secondary);">
        {w.subtitle}
      </p>
    )}

    {data && now && today ? (
      <>
        <!-- Risks first: only rendered when a trigger actually fired. -->
        {riskLines.length > 0 && (
          <div
            class="rounded-3xl border-2 p-6 sm:p-7 mb-6"
            style="border-color: var(--danger-border); background: var(--danger-bg);"
            role="alert"
          >
            <h3 class="font-semibold text-lg mb-4" style="color: var(--danger);">
              <span aria-hidden="true">⚠️</span> {b.riskTitle}
            </h3>
            <ul class="space-y-2.5 text-sm">
              {riskLines.map((line) => (
                <li class="flex gap-2 leading-relaxed" style="color: var(--danger);">
                  <span aria-hidden="true">•</span>
                  <span>{line}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        <div class="grid lg:grid-cols-[0.95fr_1.05fr] gap-6 mb-8">
          <!-- Base conditions -->
          <div class="rounded-3xl border p-6 sm:p-8" style="background: var(--card-bg); border-color: var(--border-color);">
            <div class="flex items-start justify-between gap-4">
              <div>
                <span
                  class="inline-block px-3 py-1 rounded-full text-xs font-semibold tracking-wide"
                  style="background: var(--bg-tertiary); color: var(--text-secondary);"
                >
                  {w.now}
                </span>
                <div class="font-display text-6xl sm:text-7xl font-bold leading-none mt-4" style="color: var(--text-primary);">
                  {Math.round(now.temperature)}°
                </div>
                <div class="text-lg mt-2 font-medium" style="color: var(--text-primary);">
                  {condition(now.weatherCode)}
                </div>
                <div class="text-sm mt-1" style="color: var(--text-muted);">
                  {w.today} {Math.round(today.tempMin)}° ~ {Math.round(today.tempMax)}°
                </div>
              </div>
              <div class="text-6xl sm:text-7xl leading-none" aria-hidden="true">
                {weatherCodeInfo(now.weatherCode).icon}
              </div>
            </div>

            <dl class="grid grid-cols-2 gap-4 mt-8">
              {metrics.map((m) => (
                <div class="rounded-2xl px-4 py-3" style="background: var(--bg-tertiary);">
                  <dt class="text-xs mb-1" style="color: var(--text-muted);">
                    <span aria-hidden="true">{m.icon}</span> {m.label}
                  </dt>
                  <dd class="text-sm font-semibold" style="color: var(--text-primary);">{m.value}</dd>
                </div>
              ))}
            </dl>

            <div class="flex flex-wrap gap-x-8 gap-y-2 mt-6 text-sm" style="color: var(--text-secondary);">
              <span>🌅 {w.sunrise} <strong style="color: var(--text-primary);">{today.sunrise || '—'}</strong></span>
              <span>🌇 {w.sunset} <strong style="color: var(--text-primary);">{today.sunset || '—'}</strong></span>
            </div>
          </div>

          <!-- Actionable advice: each block hides itself when empty -->
          <div class="rounded-3xl border p-6 sm:p-8" style="background: var(--card-bg); border-color: var(--border-color);">
            <h3 class="font-semibold text-lg mb-6" style="color: var(--text-primary);">{b.adviceTitle}</h3>

            {outfitLines.length > 0 && (
              <div class="mb-6">
                <h4 class="text-sm font-semibold mb-3" style="color: var(--text-primary);">
                  <span aria-hidden="true">👕</span> {b.outfitTitle}
                </h4>
                <ul class="space-y-2 text-sm">
                  {outfitLines.map((line) => (
                    <li class="flex gap-2 leading-relaxed" style="color: var(--text-secondary);">
                      <span aria-hidden="true" style="color: var(--accent);">•</span>
                      <span>{line}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {planLines.length > 0 && (
              <div class="mb-6">
                <h4 class="text-sm font-semibold mb-3" style="color: var(--text-primary);">
                  <span aria-hidden="true">🗺️</span> {b.planTitle}
                </h4>
                <ul class="space-y-2 text-sm">
                  {planLines.map((line) => (
                    <li class="flex gap-2 leading-relaxed" style="color: var(--text-secondary);">
                      <span aria-hidden="true" style="color: var(--accent);">•</span>
                      <span>{line}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {itemLines.length > 0 && (
              <div>
                <h4 class="text-sm font-semibold mb-3" style="color: var(--text-primary);">
                  <span aria-hidden="true">🎒</span> {b.itemsTitle}
                </h4>
                <ul class="flex flex-wrap gap-2">
                  {itemLines.map((line) => (
                    <li
                      class="inline-flex items-center gap-1.5 rounded-full px-3 py-1.5 text-sm"
                      style="background: var(--bg-tertiary); color: var(--text-secondary);"
                    >
                      <span aria-hidden="true">{line.icon}</span>
                      <span>{line.text}</span>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </div>

        <!-- 7-day outlook -->
        <div class="rounded-3xl border p-6 sm:p-8" style="background: var(--card-bg); border-color: var(--border-color);">
          <h3 class="font-semibold text-lg mb-6" style="color: var(--text-primary);">{w.forecastTitle}</h3>

          <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-3">
            {data.days.map((day, i) => (
              <div
                class="rounded-2xl px-3 py-4 text-center border"
                style="background: var(--bg-tertiary); border-color: var(--border-color);"
              >
                <div class="text-xs font-semibold" style="color: var(--text-primary);">
                  {i === 0 ? w.today : i === 1 ? w.tomorrow : weekdayLabel(day.date, locale)}
                </div>
                <div class="text-[11px] mb-2" style="color: var(--text-muted);">
                  {monthDayLabel(day.date, locale)}
                </div>
                <div class="text-3xl mb-2" aria-hidden="true">{weatherCodeInfo(day.weatherCode).icon}</div>
                <div class="text-[11px] mb-2 min-h-[28px] leading-tight" style="color: var(--text-secondary);">
                  {condition(day.weatherCode)}
                </div>
                <div class="text-sm font-semibold" style="color: var(--text-primary);">
                  {Math.round(day.tempMax)}°
                  <span class="font-normal" style="color: var(--text-muted);">
                    / {Math.round(day.tempMin)}°
                  </span>
                </div>
                <div class="text-[11px] mt-1 leading-relaxed" style="color: var(--text-muted);">
                  ☂️ {Math.round(day.precipProbability)}%
                  <br />
                  💨 {forceShort(day.windMax)}
                </div>
              </div>
            ))}
          </div>
        </div>
      </>
    ) : (
      <div
        class="rounded-3xl border p-10 text-center text-sm"
        style="background: var(--card-bg); border-color: var(--border-color); color: var(--text-secondary);"
      >
        {w.unavailable}
      </div>
    )}

    {w.footerNote && (
      <p class="text-xs leading-relaxed mt-6 text-center max-w-3xl mx-auto" style="color: var(--text-muted);">
        {w.footerNote}
      </p>
    )}
  </div>
</section>
