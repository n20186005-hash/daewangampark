---
import { getI18n } from '../i18n/ui';

const { messages } = getI18n(Astro.url);
const s = messages.visitorServices ?? {};
const groups = Array.isArray(s.groups) ? s.groups : [];
const availability: Record<string, string> = s.availability ?? {};
---

<section id="services" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">
      {s.title}
    </h2>
    {s.subtitle && (
      <p class="text-center text-base sm:text-lg mb-8 max-w-3xl mx-auto" style="color: var(--text-secondary);">
        {s.subtitle}
      </p>
    )}

    {s.neutralNote && (
      <p
        class="text-center text-sm leading-relaxed max-w-3xl mx-auto mb-10 px-4 py-3 rounded-xl border"
        style="background: var(--bg-tertiary); border-color: var(--border-color); color: var(--text-secondary);"
        role="note"
      >
        ⚖️ {s.neutralNote}
      </p>
    )}

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {groups.map((group: any) => (
        <article
          class="rounded-2xl border p-5 flex flex-col"
          style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);"
        >
          <div class="flex items-start justify-between gap-3 mb-3">
            <h3 class="font-semibold text-base flex items-start gap-2 leading-snug" style="color: var(--text-primary);">
              <span aria-hidden="true" class="text-xl leading-none">{group.icon}</span>
              <span>{group.title}</span>
            </h3>
            {group.status && availability[group.status] && (
              <span
                class="shrink-0 px-2.5 py-1 rounded-full text-[11px] font-semibold whitespace-nowrap"
                style="background: var(--tag-bg); color: var(--tag-text);"
              >
                {availability[group.status]}
              </span>
            )}
          </div>

          <ul class="space-y-2 text-sm leading-relaxed" style="color: var(--text-secondary);">
            {(group.items ?? []).map((item: string) => (
              <li class="flex gap-2">
                <span aria-hidden="true" style="color: var(--accent);">•</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>

          {group.note && (
            <p class="text-xs leading-relaxed mt-3 pt-3 border-t" style="border-color: var(--border-color); color: var(--text-muted);">
              {group.note}
            </p>
          )}
        </article>
      ))}
    </div>

    {s.planningNote && (
      <p class="text-xs leading-relaxed mt-8 text-center max-w-3xl mx-auto" style="color: var(--text-muted);">
        {s.planningNote}
      </p>
    )}
  </div>
</section>
