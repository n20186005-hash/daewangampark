---
import { getI18n } from '../i18n/ui';
import { place } from '../config';

const { messages } = getI18n(Astro.url);
const s = messages.sources ?? {};
const govLinks = s.govLinks ?? [];
const eeatPoints = s.eeatPoints ?? [];

// 4.2 Geographic breadcrumb chain: Full name -> City -> State/Province -> Country
const geoChain = [place.fullName, place.city, place.stateProvince, place.country];
---

<section id="sources" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{s.title}</h2>
    {s.subtitle && (
      <p class="text-center text-base sm:text-lg mb-8" style="color: var(--text-secondary);">{s.subtitle}</p>
    )}

    <nav aria-label={s.geoChainLabel ?? 'Geographic hierarchy'} class="mb-10">
      <ol class="flex flex-wrap items-center justify-center gap-1.5 text-sm" style="color: var(--text-secondary);">
        {geoChain.map((node, i) => (
          <li class="flex items-center gap-1.5">
            {i > 0 && <span aria-hidden="true" style="color: var(--accent);">→</span>}
            <span style={i === geoChain.length - 1 ? 'color: var(--text-muted);' : ''}>{node}</span>
          </li>
        ))}
      </ol>
    </nav>

    {eeatPoints.length > 0 && (
      <ul class="space-y-3 mb-10">
        {eeatPoints.map((point) => (
          <li class="flex gap-3 text-base leading-relaxed" style="color: var(--text-secondary);">
            <span aria-hidden="true" style="color: var(--accent);">✦</span>
            <span>{point}</span>
          </li>
        ))}
      </ul>
    )}

    {govLinks.length > 0 && (
      <div class="rounded-2xl border p-6 mb-6" style="background: var(--bg-tertiary); border-color: var(--border-color);">
        {s.officialTitle && (
          <h3 class="font-semibold mb-4" style="color: var(--text-primary);">{s.officialTitle}</h3>
        )}
        <ul class="space-y-2 text-sm">
          {govLinks.map((link) => (
            <li>
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="hover:opacity-70 break-words" style="color: var(--accent);">
                {link.name} ↗
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {s.officialPortalName && (
      <p class="text-sm leading-relaxed mb-6" style="color: var(--text-secondary);">
        {s.officialPortalPrefix}{' '}
        <a href={place.govtTourismUrl} target="_blank" rel="noopener noreferrer" class="font-medium" style="color: var(--accent);">
          {s.officialPortalName}
        </a>.
      </p>
    )}

    {s.dataVerified && (
      <p class="text-sm leading-relaxed mb-4" style="color: var(--text-muted);">{s.dataVerified}</p>
    )}

    {s.imageCopyright && (
      <p class="text-xs leading-relaxed pt-4 border-t" style="border-color: var(--border-color); color: var(--text-muted);">
        📷 {s.imageCopyright}
      </p>
    )}
  </div>
</section>
